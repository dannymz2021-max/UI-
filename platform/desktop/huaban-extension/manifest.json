{
  "manifest_version": 3,
  "name": "UI工作室 · 花瓣参考连接",
  "version": "1.0.0",
  "description": "使用已登录的花瓣页面搜索参考图，只与本机 UI 工作室通信；不读取 Cookie。",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://huaban.com/*",
    "https://*.huaban.com/*",
    "https://*.huabanimg.com/*",
    "http://127.0.0.1:9231/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://huaban.com/*",
        "https://www.huaban.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UI工作室花瓣连接",
    "default_popup": "popup.html"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://ui-studio-danny-rebuilt.voidgdszyy.chatgpt.site/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
